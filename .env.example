# Plantilla de configuración. Copia a ".env" y ajusta si es necesario.
# Este archivo NO contiene secretos reales (no los necesita el laboratorio).

# ── Puertos publicados en tu máquina ────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=8000

# ── Configuración del backend ───────────────────────────────────
# La ruta /app/data apunta al volumen Docker "flightdesk_data".
FLIGHTDESK_DATABASE_URL=sqlite:////app/data/flights.db

# Orígenes permitidos para CORS (solo relevante en desarrollo local
# directo; con Docker el navegador usa el proxy del frontend).
FLIGHTDESK_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Sembrar 8 vuelos de demostración en el primer arranque (true/false).
FLIGHTDESK_DEMO_SEED=true

# Nivel de logs: DEBUG, INFO, WARNING, ERROR.
FLIGHTDESK_LOG_LEVEL=INFO

# Umbral (ms) para marcar una solicitud como "lenta" en los logs.
FLIGHTDESK_SLOW_REQUEST_MS=500

# Entorno: development, staging, production.
FLIGHTDESK_ENVIRONMENT=development
